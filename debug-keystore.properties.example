# Temper Debug's distribution signer. Optional on a developer machine: without this
# file assembleDebug signs with AGP's default debug keystore, as it always did.
# debug-live.yml writes this file from the DEBUG_KEYSTORE_* repository secrets so
# every automated drop carries the same signing identity (SETUP.md §6).
# Copy to debug-keystore.properties and fill in. Both files are gitignored.

storeFile=debug-signing/temper-debug.keystore
storePassword=replace-me
keyAlias=temperdebug
keyPassword=replace-me
