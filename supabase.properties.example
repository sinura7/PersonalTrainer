# Copy to supabase.properties (gitignored) for Temper Account sign-in on local / Temper Debug builds.
# Project URL and anon (public) key from Supabase → Project Settings → API.
# Never commit the real anon key or the service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
