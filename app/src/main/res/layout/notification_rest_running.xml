<?xml version="1.0" encoding="utf-8"?>
<!-- The system draws this on its own notification surface, light or dark with the phone's
     theme, so the text takes the system's notification colours (audit RT-1). A fixed colour
     was near-white on the light theme's white card. Size, weight and face stay the app's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/rest_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rest_notification_kicker"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textSize="12sp" />

    <Chronometer
        android:id="@+id/rest_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:countDown="true"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
