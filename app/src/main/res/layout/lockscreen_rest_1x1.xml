<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockscreen_rest_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/lockscreen_rest_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="@string/lockscreen_rest_widget_kicker"
        android:textAllCaps="true"
        android:textColor="@color/overlay_volt"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lockscreen_rest_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/lockscreen_rest_widget_preview_time"
        android:textColor="@color/lock_widget_time_on_monotone"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
