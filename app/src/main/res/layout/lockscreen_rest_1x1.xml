<?xml version="1.0" encoding="utf-8"?>
<!-- TextView-only content; ProgressBar uses drawable clip (picker-safe on Samsung). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockscreen_rest_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lockscreen_rest_card_bg"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/lockscreen_rest_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sec"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/lockscreen_rest_widget_kicker"
            android:textAllCaps="true"
            android:textColor="@color/overlay_volt"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockscreen_rest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sec"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/lockscreen_rest_widget_preview_time"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/lockscreen_rest_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:indeterminate="false"
        android:max="1000"
        android:progress="700"
        android:progressDrawable="@drawable/lockscreen_rest_progress" />
</FrameLayout>
