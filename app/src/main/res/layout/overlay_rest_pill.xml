<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rest_overlay_card"
    android:layout_width="168dp"
    android:layout_height="168dp"
    android:background="@drawable/overlay_rest_card_bg"
    android:clipToPadding="false"
    android:padding="10dp">

    <com.sinura.personaltrainer.ui.overlay.RestOverlayRingView
        android:id="@+id/rest_overlay_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rest_overlay_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/lockscreen_rest_widget_kicker"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_overlay_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="1:30" />
    </LinearLayout>

    <View
        android:id="@+id/rest_overlay_resize_handle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/overlay_rest_resize_handle"
        android:contentDescription="@string/rest_overlay_resize_handle" />
</FrameLayout>
