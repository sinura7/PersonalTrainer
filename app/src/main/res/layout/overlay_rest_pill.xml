<?xml version="1.0" encoding="utf-8"?>
<!-- Draggable rest pill over home/recents — not a notification heads-up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rest_overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_rest_pill_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/rest_overlay_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        android:text="@string/rest_notification_kicker"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <Chronometer
        android:id="@+id/rest_overlay_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:countDown="true"
        android:fontFamily="monospace"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
