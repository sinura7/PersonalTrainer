<resources>
    <!-- The app ships one dark theme, so this matches values/colors.xml exactly. The night
         qualifier is kept rather than deleted: without it, a device in night mode would
         resolve a *framework* default for anything added here later, and the cold-start
         window would flash a colour the app never draws. -->
    <color name="window_background">#07090B</color>
    <color name="overlay_volt">#C2FF44</color>
    <color name="rest_exterior_stroke">#33FFFFFF</color>
    <color name="rest_exterior_handle_scrim">#66000000</color>
    <color name="lock_widget_time_on_monotone">#FF07090B</color>
</resources>
